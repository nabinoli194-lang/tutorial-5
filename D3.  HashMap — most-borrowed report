import java.util.HashMap;
import java.util.Map;

public class BorrowStats {
    public static void main(String[] args) {
        // Example borrow log with repeats
        String[] borrowLog = {
            "Data Structures", "Networking Basics", "Operating Systems",
            "Networking Basics", "Data Structures", "Networking Basics"
        };

        // ✅ Count frequencies using getOrDefault()
        HashMap<String, Integer> borrowFrequency = new HashMap<>();
        for (String title : borrowLog) {
            borrowFrequency.put(title, borrowFrequency.getOrDefault(title, 0) + 1);
        }

        // ✅ Find most-borrowed title
        String topTitle = null;
        int maxCount = 0;
        for (Map.Entry<String, Integer> entry : borrowFrequency.entrySet()) {
            if (entry.getValue() > maxCount) {
                maxCount = entry.getValue();
                topTitle = entry.getKey();
            }
        }

        // Print results
        System.out.println("Borrow frequencies: " + borrowFrequency);
        System.out.println("Most borrowed: " + topTitle + " (" + maxCount + " times)");
    }
}
